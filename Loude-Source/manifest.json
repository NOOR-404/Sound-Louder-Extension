{
  "manifest_version": 3,
  "name": "Voice Louder",
  "version": "2.0",
  "description": "A Voice Louder Work On Discord,Messenger,Instagram,Whatsapp,Imo,Snapchat,Tiktok",
  "permissions": ["activeTab","scripting"],
  "host_permissions": [
    "*://www.instagram.com/*",
    "*://*.www.instagram.com/*",
    "*://web.whatsapp.com/*",
    "*://*.web.whatsapp.com/*",
    "*://web.imo.im/*",
    "*://*.web.imo.im/*",
    "*://www.tiktok.com/*",
    "*://*.www.tiktok.com/*",
    "*://www.messenger.com/*",
    "*://*.www.messenger.com/*",
    "*://www.snapchat.com/*",
    "*://*.www.snapchat.com/*",
    "*://discord.com/*",
    "*://*.discord.com/*"
  ],"content_scripts": [{"matches": [
        "*://www.instagram.com/*",
        "*://*.www.instagram.com/*",
        "*://web.whatsapp.com/*",
        "*://*.web.whatsapp.com/*",
        "*://web.imo.im/*",
        "*://*.web.imo.im/*",
        "*://www.tiktok.com/*",
        "*://*.www.tiktok.com/*",
        "*://www.messenger.com/*",
        "*://*.www.messenger.com/*",
        "*://www.snapchat.com/*",
        "*://*.www.snapchat.com/*",
        "*://discord.com/*",
        "*://*.discord.com/*"
      ],"js": ["loader.js"],"run_at": "document_start","all_frames": true}],"web_accessible_resources": [{"resources": ["injector.js"],
      "matches": [
        "*://www.instagram.com/*",
        "*://*.www.instagram.com/*",
        "*://web.whatsapp.com/*",
        "*://*.web.whatsapp.com/*",
        "*://web.imo.im/*",
        "*://*.web.imo.im/*",
        "*://www.tiktok.com/*",
        "*://*.www.tiktok.com/*",
        "*://www.messenger.com/*",
        "*://*.www.messenger.com/*",
        "*://www.snapchat.com/*",
        "*://*.www.snapchat.com/*",
        "*://discord.com/*",
        "*://*.discord.com/*"
      ]}]}